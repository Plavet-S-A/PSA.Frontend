---
/**
 * AppTopbar — ruta actual, acceso al menú móvil y cambio de tema.
 *
 * Capa: organism
 * Props: title
 * Efectos: el botón de escritorio colapsa el sidebar; el script del layout
 * conserva la preferencia en el navegador.
 */
import Brand from '@/components/atoms/Brand.astro';
import Icon from '@/components/atoms/Icon.astro';
import ThemeToggle from '@/components/atoms/ThemeToggle.astro';

interface Props {
  /** Nombre de la pantalla actual. */
  title: string;
}

const { title } = Astro.props;
---

<header class="topbar">
  <button
    class="btn btn-ghost btn-square mobile-only"
    type="button"
    data-drawer-toggle
    aria-label="Abrir menú"
    aria-expanded="false"
    aria-controls="app-sidebar"
  >
    <Icon name="menu" size={20} />
  </button>

  <button
    class="btn btn-ghost btn-square topbar__sidebar-toggle"
    type="button"
    data-sidebar-toggle
    aria-label="Contraer menú lateral"
    aria-controls="app-sidebar"
    aria-expanded="true"
    title="Contraer menú lateral"
  >
    <Icon name="chevron-left" size={18} />
  </button>

  <span class="topbar__brand">
    <Brand href="/panel" compact />
  </span>

  <nav class="breadcrumb" aria-label="Ruta">
    <a class="breadcrumb__root" href="/panel">PSA</a>
    <span class="breadcrumb__separator" aria-hidden="true">/</span>
    <span class="breadcrumb__current" aria-current="page">{title}</span>
  </nav>

  <span class="topbar__spacer"></span>
  <ThemeToggle />
</header>
