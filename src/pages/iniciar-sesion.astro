---
import LoginForm from '@/components/organisms/LoginForm';
import AuthLayout from '@/layouts/AuthLayout.astro';

export const prerender = false;

if (Astro.locals.user) return Astro.redirect('/panel');
---

<AuthLayout
  title="Inicia sesión"
  description="Accede con tu credencial institucional para gestionar pasantías, plazas y convenios."
>
  <LoginForm client:load />
</AuthLayout>
