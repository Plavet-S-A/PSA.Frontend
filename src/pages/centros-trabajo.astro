---
import ResourceManager from '@/components/organisms/ResourceManager';
import ListPageTemplate from '@/components/templates/ListPageTemplate.astro';
import AppLayout from '@/layouts/AppLayout.astro';
import { centrosTrabajoConfig, centrosTrabajoRows } from '@/lib/catalog/centros-trabajo';
import { capabilitiesFor } from '@/lib/ui/permissions';

export const prerender = false;

const user = Astro.locals.user;
if (!user) return Astro.redirect('/iniciar-sesion');

const capabilities = capabilitiesFor(user.role);
---

<AppLayout user={user} title={centrosTrabajoConfig.plural} currentPath="/centros-trabajo">
  <ListPageTemplate title={centrosTrabajoConfig.plural} description={centrosTrabajoConfig.description}>
    <ResourceManager
      client:idle
      config={centrosTrabajoConfig}
      initialRows={centrosTrabajoRows}
      readOnly={!capabilities.canManageCatalogs}
    />
  </ListPageTemplate>
</AppLayout>
