---
import ResourceManager from '@/components/organisms/ResourceManager';
import ListPageTemplate from '@/components/templates/ListPageTemplate.astro';
import AppLayout from '@/layouts/AppLayout.astro';
import { tutoresConfig, tutoresRows } from '@/lib/catalog/tutores';
import { capabilitiesFor } from '@/lib/ui/permissions';

export const prerender = false;

const user = Astro.locals.user;
if (!user) return Astro.redirect('/iniciar-sesion');

const capabilities = capabilitiesFor(user.role);
---

<AppLayout user={user} title={tutoresConfig.plural} currentPath="/tutores">
  <ListPageTemplate title={tutoresConfig.plural} description={tutoresConfig.description}>
    <ResourceManager
      client:idle
      config={tutoresConfig}
      initialRows={tutoresRows}
      readOnly={!capabilities.canManageCatalogs}
    />
  </ListPageTemplate>
</AppLayout>
