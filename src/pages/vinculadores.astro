---
import ResourceManager from '@/components/organisms/ResourceManager';
import ListPageTemplate from '@/components/templates/ListPageTemplate.astro';
import AppLayout from '@/layouts/AppLayout.astro';
import { vinculadoresConfig, vinculadoresRows } from '@/lib/catalog/vinculadores';
import { capabilitiesFor } from '@/lib/ui/permissions';

export const prerender = false;

const user = Astro.locals.user;
if (!user) return Astro.redirect('/iniciar-sesion');

const capabilities = capabilitiesFor(user.role);
---

<AppLayout user={user} title={vinculadoresConfig.plural} currentPath="/vinculadores">
  <ListPageTemplate title={vinculadoresConfig.plural} description={vinculadoresConfig.description}>
    <ResourceManager
      client:idle
      config={vinculadoresConfig}
      initialRows={vinculadoresRows}
      readOnly={!capabilities.canManageCatalogs}
    />
  </ListPageTemplate>
</AppLayout>
