---
import ResourceManager from '@/components/organisms/ResourceManager';
import ListPageTemplate from '@/components/templates/ListPageTemplate.astro';
import AppLayout from '@/layouts/AppLayout.astro';
import { talleresConfig, talleresRows } from '@/lib/catalog/talleres';
import { capabilitiesFor } from '@/lib/ui/permissions';

export const prerender = false;

const user = Astro.locals.user;
if (!user) return Astro.redirect('/iniciar-sesion');

const capabilities = capabilitiesFor(user.role);
---

<AppLayout user={user} title={talleresConfig.plural} currentPath="/talleres">
  <ListPageTemplate title={talleresConfig.plural} description={talleresConfig.description}>
    <ResourceManager
      client:idle
      config={talleresConfig}
      initialRows={talleresRows}
      readOnly={!capabilities.canManageCatalogs}
    />
  </ListPageTemplate>
</AppLayout>
